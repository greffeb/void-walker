r_victory": true\n    },\n    {\n      "id": "coeur_reacteur",\n      "name": "Cœur du Réacteur",\n      "description": "La chaleur et le bruit sont intenses. Le cœur du réacteur pulse d\'une lumière aveuglante. La console de surcharge est juste à portée, mais les vibrations de la machine semblent amplifier le \'chant\' des cristaux.",\n      "connections": [],\n      "danger_level": 7,\n      "items": [],\n      "threats": [\n        "Radiation mineure",\n        "Exposition très élevée à la fréquence cristalline"\n      ],\n      "secrets": [],\n      "is_dead_end": true,\n      "required_for_victory": true\n    }\n  ],\n  "npcs": [\n    {\n      "id": "npc_thorne",\n      "name": "Dr. Aris Thorne",\n      "npc_type": "survivor",\n      "location": "quartiers_equipage",\n      "patrol_area": null,\n      "description": "Un homme décharné, aux yeux hagards, recroquevillé dans un casier. Il est blessé et marmonne des phrases incohérentes sur le \'chant\'.",\n      "knowledge": "Il connaît les codes de surcharge du réacteur (\'codes_surcharge_reacteur\'), mais sa paranoïa l\'empêche de les donner facilement.",\n      "has_item": null,\n      "disposition": "fearful",\n      "trigger_condition": "Approche agressive ou bruits forts le font paniquer. Un \'medkit\' et une approche calme peuvent gagner sa confiance.",\n      "weakness": null,\n      "can_be_neutralized": true,\n      "is_alive": true\n    },\n    {\n      "id": "npc_unit734",\n      "name": "UNIT-734",\n      "npc_type": "corrupted",\n      "location": "couloir_principal",\n      "patrol_area": [\n        "couloir_principal",\n        "salle_serveurs"\n      ],\n      "description": "Un androïde de maintenance dont le châssis est incrusté de cristaux. Ses optiques sont d\'un bleu glacial et il se déplace avec des mouvements saccadés et silencieux.",\n      "knowledge": "Aucun.",\n      "has_item": null,\n      "disposition": "hostile",\n      "trigger_condition": "Détecte tout son plus fort qu\'un chuchotement ou tout mouvement rapide dans sa ligne de vue.",\n      "weakness": "Est vulnérable aux impulsions IEM. Peut être désactivé de manière permanente avec un code de maintenance spécifique (\'secret_code_androide\').",\n      "can_be_neutralized": true,\n      "is_alive": true\n    }\n  ],\n  "secrets": [\n    {\n      "id": "secret_code_androide",\n      "description": "Le code de mise hors service de l\'androïde UNIT-734.",\n      "location": "quartiers_equipage",\n      "discovery_method": "Piratage du terminal de maintenance ou examen attentif d\'un manuel de réparation sous une couchette.",\n      "revelation": "Vous trouvez une commande de diagnostic d\'urgence : \'MAINT-OVERRIDE-734-SILENTIUM\'. Cela peut désactiver l\'androïde à distance s\'il est entré depuis un terminal connecté au réseau de la station.",\n      "unlocks": "Permet de neutraliser l\'NPC \'npc_unit734\' sans combat."\n    },\n    {\n      "id": "secret_trahison_thorne",\n      "description": "La cause réelle de l\'épidémie.",\n      "location": "infirmerie",\n      "discovery_method": "Trouver et écouter un enregistreur audio caché sous un lit médical.",\n      "revelation": "L\'enregistrement est un journal personnel du Dr. Thorne. Il avoue avoir désactivé les protocoles de confinement sonique du laboratoire pour accélérer ses recherches sur la croissance des cristaux, provoquant leur propagation incontrôlable.",\n      "unlocks": "Fournit un levier de pression sur le Dr. Thorne ou change la perception morale de la situation."\n    },\n    {\n      "id": "secret_frequence_cristal",\n      "description": "La fréquence de résonance destructrice des cristaux.",\n      "location": "laboratoire_specimens",\n      "discovery_method": "Utiliser un outil d\'analyse scientifique (si disponible) sur la géode principale ou trouver les notes de recherche sur un terminal endommagé.",\n      "revelation": "Les cristaux ont une fréquence de résonance harmonique. Une émission sonore puissante et précise sur cette fréquence pourrait les faire voler en éclats, mais cela nécessiterait de modifier les émetteurs de la station.",\n      "unlocks": "Une troisième voie de victoire potentielle, plus complexe (non détaillée dans la condition de victoire principale)."\n    }\n  ],\n  "environmental_clues": [\n    {\n      "type": "datapad",\n      "location": "quartiers_equipage",\n      "content": "Journal du Chef de la Sécurité, J. Kaito : \'Le chant... il est dans mes os. Je vois des angles qui ne devraient pas exister. Thorne nous a enfermés ici. Il disait que c\'était pour notre bien. Il mentait.\'"\n    },\n    {\n      "type": "wall_message",\n      "location": "couloir_principal",\n      "content": "Un message griffonné avec ce qui semble être du sang séché : \'NE FAITES PAS DE BRUIT\'."\n    },\n    {\n      "type": "audio_log",\n      "location": "salle_controle_reacteur",\n      "content": "AUDIO : (Voix paniquée de l\'ingénieur en chef) \'...purge du réacteur, code d\'autorisation Delta-7-Omega ! Je dois... le son ! C\'est trop fort ! Non, non, pas...\' (Le son d\'un millier de bris de verre, suivi d\'un silence de mort)."\n    },\n    {\n      "type": "physical_evidence",\n      "location": "infirmerie",\n      "content": "Une seringue brisée près d\'un corps pétrifié. Elle contient les résidus d\'un puissant sédatif, suggérant que certains ont essayé de s\'endormir pour échapper au \'chant\'."\n    }\n  ],\n  "validation": {\n    "critical_path": [\n      "sas_d_amarrage",\n      "quartiers_equipage",\n      "infirmerie",\n      "couloir_principal",\n      "salle_controle_reacteur",\n      "coeur_reacteur"\n    ],\n    "required_checks": [\n      "Interaction sociale (avec Thorne) OU Piratage/Investigation (pour trouver les codes)",\n      "Furtivité OU Combat (pour passer UNIT-734)",\n      "Technique (pour opérer la console du réacteur)"\n    ],\n    "estimated_difficulty": "medium",\n    "dead_end_justification": {\n      "laboratoire_specimens": "Contient le \'prototype_amortisseur\', qui débloque une condition de victoire alternative complète, et le \'secret_frequence_cristal\', une révélation majeure sur la nature de la menace. Le risque élevé (danger 9) est justifié par cette récompense significative.",\n      "coeur_reacteur": "C\'est le lieu final pour la condition de victoire principale, sa nature de \'dead end\' est donc inhérente à l\'objectif."\n    }\n  }\n}\n```', 'parsed_data': '{\'title\': \'Le Chœur Silencieux\', \'setting_type\': \'space_station\', \'setting_name\': \'Station de Recherche Echo-3\', \'premise\': "Un signal de détresse corrompu vous amène à la station de recherche Echo-3, silencieuse depuis des mois. À bord, l\'alimentation de secours peine à éclairer des couloirs recouverts d\'une étrange croissance cristalline qui semble vibrer au seuil de l\'audition. Vous devez découvrir ce qui s\'est passé et vous échapper avant que le silence ne vous engloutisse.", \'main_threat\': \'Les Cristaux Chantants\', \'threat_description\': \'Une entité cristalline semi-consciente qui se propage par le son et les vibrations. Elle ne se déplace pas, mais sa croissance est rapide. Elle émet une fréquence psionique subsonique qui, après une exposition prolongée, provoque des hallucinations auditives, une paranoïa intense, et finit par pétrifier les tissus vivants, transformant ses victimes en statues de cristal hurlantes.\', \'victory_condition\': {\'description\': \'Réactiver le réacteur principal de la station pour générer une impulsion électromagnétique massive (IEM), ce qui brisera la masse cristalline centrale et neutralisera sa fréquence psionique, vous permettant de fuir.\', \'required_items\': [\'carte_reacteur\'], \'required_info\': [\'codes_surcharge_reacteur\'], \'required_location\': \'coeur_reacteur\', \'alternative_approach\': "Trouver et activer le prototype d\'amortisseur de résonance dans le laboratoire pour créer un couloir de silence temporaire, permettant de retourner au sas et de s\'échapper sans détruire la menace."}, \'starting_location\': \'sas_d_amarrage\', \'locations\': [{\'id\': \'sas_d_amarrage\', \'name\': "Sas d\'Amarrage", \'description\': "Le sas grince en s\'ouvrant sur une obscurité presque totale, seulement percée par la lumière rouge des systèmes d\'urgence. L\'air est froid, stagnant, et sent l\'ozone et la poussière. Des cristaux fins comme des cheveux crissent sous vos bottes.", \'connections\': [\'couloir_principal\', \'quartiers_equipage\'], \'danger_level\': 1, \'items\': [], \'threats\': [\'exposition initiale à la fréquence cristalline (faible)\'], \'secrets\': [], \'is_dead_end\': False, \'required_for_victory\': False, \'visited\': False}, {\'id\': \'couloir_principal\', \'name\': \'Couloir Principal\', \'description\': "Ce large couloir est le cœur de la station, mais il est maintenant un jardin de sculptures macabres. Des membres d\'équipage pétrifiés sont figés dans des poses de panique. Des câbles pendent du plafond, et un bourdonnement basse fréquence est omniprésent.", \'connections\': [\'sas_d_amarrage\', \'infirmerie\', \'salle_serveurs\', \'salle_controle_reacteur\'], \'danger_level\': 5, \'items\': [], \'threats\': ["Patrouille de l\'androïde UNIT-734", \'Exposition modérée à la fréquence cristalline\'], \'secrets\': [], \'is_dead_end\': False, \'required_for_victory\': False, \'visited\': False}, {\'id\': \'quartiers_equipage\', \'name\': "Quartiers de l\'Équipage", \'description\': \'Les quartiers sont dans un désordre total, les couchettes retournées et les casiers ouverts à la volée. Un silence oppressant règne ici, comme si le son était absorbé par les murs. Un terminal de maintenance clignote faiblement dans un coin.\', \'connections\': [\'sas_d_amarrage\', \'infirmerie\'], \'danger_level\': 4, \'items\': [{\'id\': \'carte_reacteur\', \'name\': "Carte d\'accès au réacteur", \'description\': "Une carte d\'accès de niveau ingénieur, nécessaire pour déverrouiller la salle de contrôle du réacteur.", \'item_type\': \'key_item\', \'uses\': None, \'stat_bonus\': {}}, {\'id\': \'ruban_adhesif\', \'name\': \'Ruban adhésif industriel\', \'description\': \'Extrêmement résistant. Utile pour des réparations improvisées ou pour piéger des objets.\', \'item_type\': \'tool\', \'uses\': None, \'stat_bonus\': {}}], \'threats\': [], \'secrets\': [\'secret_code_androide\'], \'is_dead_end\': False, \'required_for_victory\': False, \'visited\': False}, {\'id\': \'infirmerie\', \'name\': \'Infirmerie\', \'description\': "L\'odeur d\'antiseptique se mêle à une puanteur métallique. Des instruments chirurgicaux sont éparpillés sur le sol, à côté de fragments de cristal. Un lit médical est renversé, cachant un enregistreur audio.", \'connections\': [\'couloir_principal\', \'quartiers_equipage\', \'laboratoire_specimens\'], \'danger_level\': 3, \'items\': [{\'id\': \'medkit\', \'name\': \'Medkit\', \'description\': \'Contient des stimulateurs de coagulation et des analgésiques. Restaure la santé.\', \'item_type\': \'consumable\', \'uses\': None, \'stat_bonus\': {}}], \'threats\': [], \'secrets\': [\'secret_trahison_thorne\'], \'is_dead_end\': False, \'required_for_victory\': False, \'visited\': False}, {\'id\': \'laboratoire_specimens\', \'name\': \'Laboratoire des Spécimens\', \'description\': \'Le cœur de la contamination. Une énorme géode cristalline palpite doucement au centre de la pièce, émettant une lueur bleue. La fréquence psionique est presque insupportable ici, faisant vibrer vos dents.\', \'connections\': [\'infirmerie\'], \'danger_level\': 9, \'items\': [{\'id\': \'prototype_amortisseur\', \'name\': "Prototype d\'Amortisseur de Résonance", \'description\': "Un appareil expérimental conçu pour émettre des ondes sonores en opposition de phase, créant des zones de silence total. Nécessite une source d\'énergie pour être activé.", \'item_type\': \'key_item\', \'uses\': None, \'stat_bonus\': {}}], \'threats\': [\'Exposition critique à la fréquence cristalline\', "Risque d\'effondrement stru