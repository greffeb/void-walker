er_level": 6,\n      "items": [\n        {\n          "id": "sonic_emitter",\n          "name": "Émetteur Sonique de Nettoyage",\n          "description": "Un outil industriel utilisé pour nettoyer les conduits par vibrations. Il émet une fréquence basse désagréable.",\n          "item_type": "tool",\n          "stat_bonus": null\n        }\n      ],\n      "threats": ["Surtension électrique aléatoire"],\n      "secrets": [],\n      "is_dead_end": true,\n      "required_for_victory": false,\n      "is_hidden": false\n    },\n    {\n      "id": "medbay",\n      "name": "Infirmerie",\n      "description": "Des instruments chirurgicaux sont éparpillés sur le sol. Une stase médicale est active, son occupant se balançant doucement à l\'intérieur. Les murs sont couverts de formules et de diagrammes paranoïaques griffonnés.",\n      "connections": ["main_corridor"],\n      "danger_level": 7,\n      "items": [\n        {\n          "id": "neuro_stabilizer_canister",\n          "name": "Canister Neuro-Stabilisateur",\n          "description": "Un gaz expérimental conçu pour calmer l\'activité neuronale anormale.",\n          "item_type": "key_item",\n          "stat_bonus": null\n        }\n      ],\n      "threats": ["Présence psychique concentrée"],\n      "secrets": ["secret_medic_research"],\n      "is_dead_end": false,\n      "required_for_victory": false,\n      "is_hidden": false\n    },\n    {\n      "id": "engine_room",\n      "name": "Salle des Machines",\n      "description": "Le cœur du réacteur palpite d\'une lueur maladive. Le bourdonnement constant est presque hypnotique. Un terminal de diagnostic affiche un flux incessant de messages d\'erreur.",\n      "connections": ["main_corridor"],\n      "danger_level": 6,\n      "items": [\n        {\n          "id": "drive_restart_sequence",\n          "name": "Séquence de Redémarrage",\n          "description": "Données contenant la procédure exacte pour réamorcer le Moteur Quantique.",\n          "item_type": "data"