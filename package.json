{
  "name": "void-walker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "check:imports": "tsx tools/check-imports.ts",
    "check:links": "tsx tools/check-links.ts",
    "check:texts": "tsx tools/check-texts.ts",
    "check:stations": "tsx tools/verifier-station.ts",
    "mesurer:tirages": "tsx tools/mesurer-tirages.ts",
    "parcours": "tsx tools/rejouer-parcours.ts",
    "cli": "tsx cli/main.ts",
    "rejouer": "tsx tools/rejouer-export.ts",
    "icones": "tsx tools/generer-icones.ts",
    "build": "vite build",
    "preview": "vite preview",
    "captures": "tsx tools/captures.ts",
    "test": "vitest run",
    "verify": "tsx tools/verify.ts",
    "verify:complet": "tsx tools/verify.ts --complet",
    "check:sortie": "tsx tools/verifier-sortie.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
